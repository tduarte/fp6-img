+static int s5kkd1_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct s5kkd1 *s5kkd1 = container_of(ctrl->handler, struct s5kkd1,
+					     ctrl_handler);
+	const struct s5kkd1_mode *mode = s5kkd1->mode;
+	s64 exposure_max;
+	int ret;
+
+	/* Propagate change of current control to all related controls */
+	switch (ctrl->id) {
+	case V4L2_CID_VBLANK:
+		/* Update max exposure while meeting expected vblanking */
+		exposure_max = mode->height + ctrl->val - mode->exposure_margin;
+		__v4l2_ctrl_modify_range(s5kkd1->exposure,
+					 s5kkd1->exposure->minimum,
+					 exposure_max,
+					 s5kkd1->exposure->step,
+					 s5kkd1->exposure->default_value);
+		break;
+	}
+
+	/* V4L2 controls are applied, when sensor is powered up for streaming */
+	if (!pm_runtime_get_if_active(s5kkd1->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = cci_write(s5kkd1->regmap, S5KKD1_REG_AGAIN,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(s5kkd1->regmap, S5KKD1_REG_EXPOSURE,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(s5kkd1->regmap, S5KKD1_REG_VTS,
+				ctrl->val + mode->height, NULL);
+		break;
+	case V4L2_CID_VFLIP:
+	case V4L2_CID_HFLIP:
+		ret = cci_write(s5kkd1->regmap, S5KKD1_REG_ORIENTATION,
+				(s5kkd1->vflip->val ? S5KKD1_VFLIP : 0) |
+				(s5kkd1->hflip->val ? S5KKD1_HFLIP : 0), NULL);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		ret = cci_write(s5kkd1->regmap, S5KKD1_REG_TEST_PATTERN,
+				ctrl->val, NULL);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put(s5kkd1->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops s5kkd1_ctrl_ops = {
+	.s_ctrl = s5kkd1_set_ctrl,
+};
+
+static int s5kkd1_init_controls(struct s5kkd1 *s5kkd1)
+{
+	struct v4l2_ctrl_handler *ctrl_hdlr = &s5kkd1->ctrl_handler;
+	const struct s5kkd1_mode *mode = s5kkd1->mode;
+	s64 pixel_rate, hblank, vblank, exposure_max;
+	struct v4l2_fwnode_device_properties props;
+	int ret;
+
+	v4l2_ctrl_handler_init(ctrl_hdlr, 9);
+
+	s5kkd1->link_freq = v4l2_ctrl_new_int_menu(ctrl_hdlr, &s5kkd1_ctrl_ops,
+					V4L2_CID_LINK_FREQ,
+					ARRAY_SIZE(s5kkd1_link_freq_menu) - 1,
+					0, s5kkd1_link_freq_menu);
+	if (s5kkd1->link_freq)
+		s5kkd1->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	pixel_rate = S5KKD1_PIXEL_RATE;
+	s5kkd1->pixel_rate = v4l2_ctrl_new_std(ctrl_hdlr, &s5kkd1_ctrl_ops,
+					       V4L2_CID_PIXEL_RATE,
+					       0, pixel_rate, 1, pixel_rate);
+
+	hblank = mode->hts - mode->width;
+	s5kkd1->hblank = v4l2_ctrl_new_std(ctrl_hdlr, &s5kkd1_ctrl_ops,
+					   V4L2_CID_HBLANK, hblank,
+					   hblank, 1, hblank);
+	if (s5kkd1->hblank)
+		s5kkd1->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	vblank = mode->vts - mode->height;
+	s5kkd1->vblank = v4l2_ctrl_new_std(ctrl_hdlr, &s5kkd1_ctrl_ops,
+					   V4L2_CID_VBLANK, vblank,
+					   S5KKD1_VTS_MAX - mode->height, 1,
+					   vblank);
+
+	v4l2_ctrl_new_std(ctrl_hdlr, &s5kkd1_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  S5KKD1_AGAIN_MIN, S5KKD1_AGAIN_MAX,
+			  S5KKD1_AGAIN_STEP, S5KKD1_AGAIN_DEFAULT);
+
+	exposure_max = mode->vts - mode->exposure_margin;
+	s5kkd1->exposure = v4l2_ctrl_new_std(ctrl_hdlr, &s5kkd1_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     S5KKD1_EXPOSURE_MIN,
+					     exposure_max,
+					     S5KKD1_EXPOSURE_STEP,
+					     mode->exposure);
+
+	v4l2_ctrl_new_std_menu_items(ctrl_hdlr, &s5kkd1_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(s5kkd1_test_pattern_menu) - 1,
+				     0, 0, s5kkd1_test_pattern_menu);
+
+	s5kkd1->hflip = v4l2_ctrl_new_std(ctrl_hdlr, &s5kkd1_ctrl_ops,
+					  V4L2_CID_HFLIP, 0, 1, 1, 0);
+	if (s5kkd1->hflip)
+		s5kkd1->hflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	s5kkd1->vflip = v4l2_ctrl_new_std(ctrl_hdlr, &s5kkd1_ctrl_ops,
+					  V4L2_CID_VFLIP, 0, 1, 1, 0);
+	if (s5kkd1->vflip)
+		s5kkd1->vflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	ret = v4l2_fwnode_device_parse(s5kkd1->dev, &props);
+	if (ret)
+		goto error_free_hdlr;
+
+	ret = v4l2_ctrl_new_fwnode_properties(ctrl_hdlr, &s5kkd1_ctrl_ops,
+					      &props);
+	if (ret)
+		goto error_free_hdlr;
+
+	s5kkd1->sd.ctrl_handler = ctrl_hdlr;
+
+	return 0;
+
+error_free_hdlr:
+	v4l2_ctrl_handler_free(ctrl_hdlr);
+
+	return ret;
+}
+
+static int s5kkd1_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct s5kkd1 *s5kkd1 = to_s5kkd1(sd);
+	const struct s5kkd1_reg_list *reg_list = &s5kkd1->mode->reg_list;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(s5kkd1->dev);
+	if (ret)
+		return ret;
+
+	/* Init sequence from the vendor settings, including its two delays */
+	cci_multi_reg_write(s5kkd1->regmap, s5kkd1_init_0,
+			    ARRAY_SIZE(s5kkd1_init_0), &ret);
+	if (ret)
+		goto error;
+
+	usleep_range(10 * USEC_PER_MSEC, 11 * USEC_PER_MSEC);
+
+	cci_multi_reg_write(s5kkd1->regmap, s5kkd1_init_1,
+			    ARRAY_SIZE(s5kkd1_init_1), &ret);
+	if (ret)
+		goto error;
+
+	usleep_range(10 * USEC_PER_MSEC, 11 * USEC_PER_MSEC);
+
+	cci_multi_reg_write(s5kkd1->regmap, s5kkd1_init_2,
+			    ARRAY_SIZE(s5kkd1_init_2), &ret);
+	cci_multi_reg_write(s5kkd1->regmap, reg_list->regs,
+			    reg_list->num_regs, &ret);
+	if (ret)
+		goto error;
+
+	ret = __v4l2_ctrl_handler_setup(s5kkd1->sd.ctrl_handler);
+
+	cci_write(s5kkd1->regmap, S5KKD1_REG_CTRL_MODE,
+		  S5KKD1_MODE_STREAMING, &ret);
+	if (ret)
+		goto error;
+
+	return 0;
+
+error:
+	dev_err(s5kkd1->dev, "failed to start streaming: %d\n", ret);
+	pm_runtime_put_autosuspend(s5kkd1->dev);
+
+	return ret;
+}
+
+static int s5kkd1_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct s5kkd1 *s5kkd1 = to_s5kkd1(sd);
+	int ret;
+
+	ret = cci_write(s5kkd1->regmap, S5KKD1_REG_CTRL_MODE, 0x0, NULL);
+	if (ret)
+		dev_err(s5kkd1->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(s5kkd1->dev);
+
+	return ret;
+}
+
+static u32 s5kkd1_get_format_code(struct s5kkd1 *s5kkd1)
+{
+	unsigned int i;
+
+	i = (s5kkd1->vflip->val ? 2 : 0) | (s5kkd1->hflip->val ? 1 : 0);
+
+	return s5kkd1_mbus_formats[i];
+}
+
+static void s5kkd1_update_pad_format(struct s5kkd1 *s5kkd1,
+				     const struct s5kkd1_mode *mode,
+				     struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = s5kkd1_get_format_code(s5kkd1);
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_SRGB;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int s5kkd1_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct s5kkd1 *s5kkd1 = to_s5kkd1(sd);
+	s64 hblank, vblank, exposure_max;
+	const struct s5kkd1_mode *mode;
+
+	mode = v4l2_find_nearest_size(s5kkd1_supported_modes,
+				      ARRAY_SIZE(s5kkd1_supported_modes),
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	s5kkd1_update_pad_format(s5kkd1, mode, &fmt->format);
+
+	/* Format code could be updated with respect to flip controls */
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY || s5kkd1->mode == mode)
+		goto set_format;
+
+	/* Update limits and set FPS and exposure to default values */
+	hblank = mode->hts - mode->width;
+	__v4l2_ctrl_modify_range(s5kkd1->hblank, hblank, hblank, 1, hblank);
+
+	vblank = mode->vts - mode->height;
+	__v4l2_ctrl_modify_range(s5kkd1->vblank, vblank,
+				 S5KKD1_VTS_MAX - mode->height, 1, vblank);
+	__v4l2_ctrl_s_ctrl(s5kkd1->vblank, vblank);
+
+	exposure_max = mode->vts - mode->exposure_margin;
+	__v4l2_ctrl_modify_range(s5kkd1->exposure, S5KKD1_EXPOSURE_MIN,
+				 exposure_max, S5KKD1_EXPOSURE_STEP,
+				 mode->exposure);
+	__v4l2_ctrl_s_ctrl(s5kkd1->exposure, mode->exposure);
+
+	if (s5kkd1->sd.ctrl_handler->error)
+		return s5kkd1->sd.ctrl_handler->error;
+
+	s5kkd1->mode = mode;
+
+set_format:
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+
+	return 0;
+}
+
+static int s5kkd1_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	struct s5kkd1 *s5kkd1 = to_s5kkd1(sd);
+
+	/* Media bus code index is constant, but code formats are not */
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = s5kkd1_get_format_code(s5kkd1);
+
+	return 0;
+}
+
+static int s5kkd1_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *sd_state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct s5kkd1 *s5kkd1 = to_s5kkd1(sd);
+
+	if (fse->index >= ARRAY_SIZE(s5kkd1_supported_modes))
+		return -EINVAL;
+
+	if (fse->code != s5kkd1_get_format_code(s5kkd1))
+		return -EINVAL;
+
+	fse->min_width = s5kkd1_supported_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = s5kkd1_supported_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int s5kkd1_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *sd_state,
+				struct v4l2_subdev_selection *sel)
+{
+	struct s5kkd1 *s5kkd1 = to_s5kkd1(sd);
+
+	if (sel->which != V4L2_SUBDEV_FORMAT_ACTIVE)
+		return -EINVAL;
+
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = s5kkd1->mode->crop;
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = S5KKD1_PIXEL_ARRAY_WIDTH;
+		sel->r.height = S5KKD1_PIXEL_ARRAY_HEIGHT;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int s5kkd1_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct s5kkd1 *s5kkd1 = to_s5kkd1(sd);
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+		.format = {
+			/* Media bus code depends on current flip controls */
+			.width = s5kkd1->mode->width,
+			.height = s5kkd1->mode->height,
+		},
+	};
+
+	s5kkd1_set_pad_format(sd, state, &fmt);
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops s5kkd1_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops s5kkd1_pad_ops = {
+	.set_fmt = s5kkd1_set_pad_format,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.get_selection = s5kkd1_get_selection,
+	.enum_mbus_code = s5kkd1_enum_mbus_code,
+	.enum_frame_size = s5kkd1_enum_frame_size,
+	.enable_streams = s5kkd1_enable_streams,
+	.disable_streams = s5kkd1_disable_streams,
+};
+
+static const struct v4l2_subdev_ops s5kkd1_subdev_ops = {
+	.video = &s5kkd1_video_ops,
+	.pad = &s5kkd1_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops s5kkd1_internal_ops = {
+	.init_state = s5kkd1_init_state,
+};
+
+static const struct media_entity_operations s5kkd1_subdev_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+static int s5kkd1_identify_sensor(struct s5kkd1 *s5kkd1)
+{
+	u64 val;
+	int ret;
+
+	ret = cci_read(s5kkd1->regmap, S5KKD1_REG_CHIP_ID, &val, NULL);
+	if (ret) {
+		dev_err(s5kkd1->dev, "failed to read chip id: %d\n", ret);
+		return ret;
+	}
+
+	if (val != S5KKD1_CHIP_ID) {
+		dev_err(s5kkd1->dev, "chip id mismatch: %x!=%llx\n",
+			S5KKD1_CHIP_ID, val);
+		return -ENODEV;
+	}
+
+	return 0;
+}
+
+static int s5kkd1_check_hwcfg(struct s5kkd1 *s5kkd1)
+{
+	struct fwnode_handle *fwnode = dev_fwnode(s5kkd1->dev), *ep;
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus = {
+			.mipi_csi2 = {
+				.num_data_lanes = S5KKD1_DATA_LANES,
+			},
+		},
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	unsigned long freq_bitmap;
+	int ret;
+
+	if (!fwnode)
+		return -ENODEV;
+
+	ep = fwnode_graph_get_next_endpoint(fwnode, NULL);
+	if (!ep)
+		return -EINVAL;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != S5KKD1_DATA_LANES) {
+		dev_err(s5kkd1->dev, "Invalid number of data lanes: %u\n",
+			bus_cfg.bus.mipi_csi2.num_data_lanes);
+		ret = -EINVAL;
+		goto endpoint_free;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(s5kkd1->dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       s5kkd1_link_freq_menu,
+				       ARRAY_SIZE(s5kkd1_link_freq_menu),
+				       &freq_bitmap);
+
+endpoint_free:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+
+	return ret;
+}
+
+static int s5kkd1_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5kkd1 *s5kkd1 = to_s5kkd1(sd);
+	int ret;
+
+	if (s5kkd1->vddd) {
+		ret = regulator_enable(s5kkd1->vddd);
+		if (ret)
+			return ret;
+
+		usleep_range(USEC_PER_MSEC, 2 * USEC_PER_MSEC);
+	}
+
+	if (s5kkd1->vdda) {
+		ret = regulator_enable(s5kkd1->vdda);
+		if (ret)
+			goto disable_vddd;
+	}
+
+	if (s5kkd1->vddio) {
+		ret = regulator_enable(s5kkd1->vddio);
+		if (ret)
+			goto disable_vdda;
+	}
+
+	if (s5kkd1->afvdd) {
+		ret = regulator_enable(s5kkd1->afvdd);
+		if (ret)
+			goto disable_vddio;
+	}
+
+	ret = clk_prepare_enable(s5kkd1->mclk);
+	if (ret)
+		goto disable_regulators;
+
+	gpiod_set_value_cansleep(s5kkd1->reset_gpio, 0);
+	usleep_range(10 * USEC_PER_MSEC, 15 * USEC_PER_MSEC);
+
+	return 0;
+
+disable_regulators:
+	if (s5kkd1->afvdd)
+		regulator_disable(s5kkd1->afvdd);
+
+disable_vddio:
+	if (s5kkd1->vddio)
+		regulator_disable(s5kkd1->vddio);
+
+disable_vdda:
+	if (s5kkd1->vdda)
+		regulator_disable(s5kkd1->vdda);
+
+disable_vddd:
+	if (s5kkd1->vddd) {
+		usleep_range(USEC_PER_MSEC, 2 * USEC_PER_MSEC);
+		regulator_disable(s5kkd1->vddd);
+	}
+
+	return ret;
+}
+
+static int s5kkd1_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5kkd1 *s5kkd1 = to_s5kkd1(sd);
+
+	gpiod_set_value_cansleep(s5kkd1->reset_gpio, 1);
+
+	clk_disable_unprepare(s5kkd1->mclk);
+
+	if (s5kkd1->afvdd)
+		regulator_disable(s5kkd1->afvdd);
+
+	if (s5kkd1->vddio)
+		regulator_disable(s5kkd1->vddio);
+
+	if (s5kkd1->vdda)
+		regulator_disable(s5kkd1->vdda);
+
+	if (s5kkd1->vddd) {
+		usleep_range(USEC_PER_MSEC, 2 * USEC_PER_MSEC);
+		regulator_disable(s5kkd1->vddd);
+	}
+
+	return 0;
+}
+
+static int s5kkd1_probe(struct i2c_client *client)
+{
+	struct s5kkd1 *s5kkd1;
+	unsigned long freq;
+	int ret;
+
+	s5kkd1 = devm_kzalloc(&client->dev, sizeof(*s5kkd1), GFP_KERNEL);
+	if (!s5kkd1)
+		return -ENOMEM;
+
+	s5kkd1->dev = &client->dev;
+	v4l2_i2c_subdev_init(&s5kkd1->sd, client, &s5kkd1_subdev_ops);
+
+	s5kkd1->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(s5kkd1->regmap))
+		return dev_err_probe(s5kkd1->dev, PTR_ERR(s5kkd1->regmap),
+				     "failed to init CCI\n");
+
+	s5kkd1->mclk = devm_v4l2_sensor_clk_get(s5kkd1->dev, NULL);
+	if (IS_ERR(s5kkd1->mclk))
+		return dev_err_probe(s5kkd1->dev, PTR_ERR(s5kkd1->mclk),
+				     "failed to get MCLK clock\n");
+
+	freq = clk_get_rate(s5kkd1->mclk);
+	if (freq != S5KKD1_MCLK_FREQ_24MHZ)
+		return dev_err_probe(s5kkd1->dev, -EINVAL,
+				     "MCLK clock frequency %lu is not supported\n",
+				     freq);
+
+	ret = s5kkd1_check_hwcfg(s5kkd1);
+	if (ret)
+		return dev_err_probe(s5kkd1->dev, ret,
+				     "failed to check HW configuration\n");
+
+	s5kkd1->reset_gpio = devm_gpiod_get_optional(s5kkd1->dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(s5kkd1->reset_gpio))
+		return dev_err_probe(s5kkd1->dev, PTR_ERR(s5kkd1->reset_gpio),
+				     "cannot get reset GPIO\n");
+
+	s5kkd1->afvdd = devm_regulator_get_optional(s5kkd1->dev, "afvdd");
+	if (IS_ERR(s5kkd1->afvdd)) {
+		ret = PTR_ERR(s5kkd1->afvdd);
+		if (ret != -ENODEV) {
+			return dev_err_probe(s5kkd1->dev, ret,
+					"Failed to get 'afvdd' regulator\n");
+		}
+
+		s5kkd1->afvdd = NULL;
+	}
+
+	s5kkd1->vdda = devm_regulator_get_optional(s5kkd1->dev, "vdda");
+	if (IS_ERR(s5kkd1->vdda)) {
+		ret = PTR_ERR(s5kkd1->vdda);
+		if (ret != -ENODEV) {
+			return dev_err_probe(s5kkd1->dev, ret,
+					"Failed to get 'vdda' regulator\n");
+		}
+
+		s5kkd1->vdda = NULL;
+	}
+
+	s5kkd1->vddd = devm_regulator_get_optional(s5kkd1->dev, "vddd");
+	if (IS_ERR(s5kkd1->vddd)) {
+		ret = PTR_ERR(s5kkd1->vddd);
+		if (ret != -ENODEV) {
+			return dev_err_probe(s5kkd1->dev, ret,
+					"Failed to get 'vddd' regulator\n");
+		}
+
+		s5kkd1->vddd = NULL;
+	}
+
+	s5kkd1->vddio = devm_regulator_get_optional(s5kkd1->dev, "vddio");
+	if (IS_ERR(s5kkd1->vddio)) {
+		ret = PTR_ERR(s5kkd1->vddio);
+		if (ret != -ENODEV) {
+			return dev_err_probe(s5kkd1->dev, ret,
+					"Failed to get 'vddio' regulator\n");
+		}
+
+		s5kkd1->vddio = NULL;
+	}
+
+	/* The sensor must be powered on to read the CHIP_ID register */
+	ret = s5kkd1_power_on(s5kkd1->dev);
+	if (ret)
+		return ret;
+
+	ret = s5kkd1_identify_sensor(s5kkd1);
+	if (ret) {
+		dev_err_probe(s5kkd1->dev, ret, "failed to find sensor\n");
+		goto power_off;
+	}
+
+	s5kkd1->mode = &s5kkd1_supported_modes[0];
+	ret = s5kkd1_init_controls(s5kkd1);
+	if (ret) {
+		dev_err_probe(s5kkd1->dev, ret, "failed to init controls\n");
+		goto power_off;
+	}
+
+	s5kkd1->sd.state_lock = s5kkd1->ctrl_handler.lock;
+	s5kkd1->sd.internal_ops = &s5kkd1_internal_ops;
+	s5kkd1->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	s5kkd1->sd.entity.ops = &s5kkd1_subdev_entity_ops;
+	s5kkd1->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	s5kkd1->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&s5kkd1->sd.entity, 1, &s5kkd1->pad);
+	if (ret) {
+		dev_err_probe(s5kkd1->dev, ret,
+			      "failed to init media entity pads\n");
+		goto v4l2_ctrl_handler_free;
+	}
+
+	ret = v4l2_subdev_init_finalize(&s5kkd1->sd);
+	if (ret < 0) {
+		dev_err_probe(s5kkd1->dev, ret,
+			      "failed to init media entity pads\n");
+		goto media_entity_cleanup;
+	}
+
+	pm_runtime_set_active(s5kkd1->dev);
+	pm_runtime_enable(s5kkd1->dev);
+
+	ret = v4l2_async_register_subdev_sensor(&s5kkd1->sd);
+	if (ret < 0) {
+		dev_err_probe(s5kkd1->dev, ret,
+			      "failed to register V4L2 subdev\n");
+		goto subdev_cleanup;
+	}
+
+	pm_runtime_set_autosuspend_delay(s5kkd1->dev, 1000);
+	pm_runtime_use_autosuspend(s5kkd1->dev);
+	pm_runtime_idle(s5kkd1->dev);
+
+	return 0;
+
+subdev_cleanup:
+	v4l2_subdev_cleanup(&s5kkd1->sd);
+	pm_runtime_disable(s5kkd1->dev);
+	pm_runtime_set_suspended(s5kkd1->dev);
+
+media_entity_cleanup:
+	media_entity_cleanup(&s5kkd1->sd.entity);
+
+v4l2_ctrl_handler_free:
+	v4l2_ctrl_handler_free(s5kkd1->sd.ctrl_handler);
+
+power_off:
+	s5kkd1_power_off(s5kkd1->dev);
+
+	return ret;
+}
+
+static void s5kkd1_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct s5kkd1 *s5kkd1 = to_s5kkd1(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+	pm_runtime_disable(s5kkd1->dev);
+
+	if (!pm_runtime_status_suspended(s5kkd1->dev)) {
+		s5kkd1_power_off(s5kkd1->dev);
+		pm_runtime_set_suspended(s5kkd1->dev);
+	}
+}
+
+static const struct dev_pm_ops s5kkd1_pm_ops = {
+	SET_RUNTIME_PM_OPS(s5kkd1_power_off, s5kkd1_power_on, NULL)
+};
+
+static const struct of_device_id s5kkd1_of_match[] = {
+	{ .compatible = "samsung,s5kkd1" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, s5kkd1_of_match);
+
+static struct i2c_driver s5kkd1_i2c_driver = {
+	.driver = {
+		.name = "s5kkd1",
+		.pm = &s5kkd1_pm_ops,
+		.of_match_table = s5kkd1_of_match,
+	},
+	.probe = s5kkd1_probe,
+	.remove = s5kkd1_remove,
+};
+
+module_i2c_driver(s5kkd1_i2c_driver);
+
+MODULE_AUTHOR("Vladimir Zapolskiy <vladimir.zapolskiy@linaro.org>");
+MODULE_DESCRIPTION("Samsung S5KKD1 image sensor driver");
+MODULE_LICENSE("GPL");
