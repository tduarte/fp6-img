From b434b04a578046108e680dc6c647a9c99154eb2b Mon Sep 17 00:00:00 2001
From: Thiago Duarte <me@tduarte.co>
Date: Sat, 14 Nov 2026 19:12:31 -0800
Subject: [PATCH 3/4] media: i2c: Add Samsung S5KKD1 image sensor driver

Add a driver for the Samsung S5KKD1 (S5KKD1SP) 32 MP sensor, the front
camera of the Fairphone (Gen. 6). The structure follows the S5KJN1 driver.

The sensor answers MIPI CCS identification reads (model 0x4841), but its
capability and frame format registers do not hold usable values, so it is
driven with fixed register tables instead of the generic CCS driver. The
initialisation sequence and mode tables are taken from the phone's vendor
sensor configuration. Three modes are provided: 3104x2336 (2x2 binned,
30 fps), 6208x4672 (15 fps) and 1920x1080 (120 fps). All use four data
lanes at a 906 MHz link frequency and a 560 MHz pixel rate.

Tested on a Fairphone (Gen. 6) in the 3104x2336 mode only: chip
identification, raw capture through CAMSS, the colour bar test pattern
(which confirms the GRBG order) and the analogue gain control. The other
two modes, the flip controls and the exposure range are untested, and
there is no DT binding document yet.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 drivers/media/i2c/Kconfig  |   10 +
 drivers/media/i2c/Makefile |    1 +
 drivers/media/i2c/s5kkd1.c | 1889 ++++++++++++++++++++++++++++++++++++
 3 files changed, 1900 insertions(+)
 create mode 100644 drivers/media/i2c/s5kkd1.c

diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 7c610ae9e9e9..2a370d1efc4b 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -837,6 +837,16 @@ config VIDEO_S5KJN1
 	  To compile this driver as a module, choose M here: the
 	  module will be called s5kjn1.
 
+config VIDEO_S5KKD1
+	tristate "Samsung S5KKD1 sensor support"
+	select V4L2_CCI_I2C
+	help
+	  This is a V4L2 sensor driver for Samsung S5KKD1 32MP raw
+	  camera sensor.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called s5kkd1.
+
 config VIDEO_T4KA3
 	tristate "Toshiba T4KA3 sensor support"
 	depends on ACPI || COMPILE_TEST
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
index 505ae8c13740..b5d19d4149b7 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -135,6 +135,7 @@ obj-$(CONFIG_VIDEO_S5K3M5) += s5k3m5.o
 obj-$(CONFIG_VIDEO_S5K5BAF) += s5k5baf.o
 obj-$(CONFIG_VIDEO_S5K6A3) += s5k6a3.o
 obj-$(CONFIG_VIDEO_S5KJN1) += s5kjn1.o
+obj-$(CONFIG_VIDEO_S5KKD1) += s5kkd1.o
 obj-$(CONFIG_VIDEO_SAA6588) += saa6588.o
 obj-$(CONFIG_VIDEO_SAA6752HS) += saa6752hs.o
 obj-$(CONFIG_VIDEO_SAA7110) += saa7110.o
