+#include <media/v4l2-fwnode.h>
+
+#define S5KKD1_LINK_FREQ_906MHZ		(906ULL * HZ_PER_MHZ)
+/* VT pixel clock 140 MHz, four pixels per clock */
+#define S5KKD1_PIXEL_RATE		(560ULL * HZ_PER_MHZ)
+#define S5KKD1_MCLK_FREQ_24MHZ		(24 * HZ_PER_MHZ)
+#define S5KKD1_DATA_LANES		4
+
+/* Register map is similar to MIPI CCS compliant camera sensors */
+#define S5KKD1_REG_CHIP_ID		CCI_REG16(0x0000)
+#define S5KKD1_CHIP_ID			0x4841
+
+#define S5KKD1_REG_CTRL_MODE		CCI_REG8(0x0100)
+#define S5KKD1_MODE_STREAMING		BIT(0)
+
+#define S5KKD1_REG_ORIENTATION		CCI_REG8(0x0101)
+#define S5KKD1_VFLIP			BIT(1)
+#define S5KKD1_HFLIP			BIT(0)
+
+/* Pixel array: the full-resolution readout, 6208x4672 */
+#define S5KKD1_PIXEL_ARRAY_WIDTH	6208
+#define S5KKD1_PIXEL_ARRAY_HEIGHT	4672
+
+#define S5KKD1_REG_EXPOSURE		CCI_REG16(0x0202)
+#define S5KKD1_EXPOSURE_MIN		8
+#define S5KKD1_EXPOSURE_STEP		1
+
+#define S5KKD1_REG_AGAIN		CCI_REG16(0x0204)
+/* Gain register code, 32 is 1x */
+#define S5KKD1_AGAIN_MIN		32
+#define S5KKD1_AGAIN_MAX		512
+#define S5KKD1_AGAIN_STEP		1
+#define S5KKD1_AGAIN_DEFAULT		32
+
+#define S5KKD1_REG_VTS			CCI_REG16(0x0340)
+#define S5KKD1_VTS_MAX			0xffff
+
+#define S5KKD1_REG_HTS			CCI_REG16(0x0342)
+#define S5KKD1_REG_X_ADDR_START		CCI_REG16(0x0344)
+#define S5KKD1_REG_Y_ADDR_START		CCI_REG16(0x0346)
+#define S5KKD1_REG_X_ADDR_END		CCI_REG16(0x0348)
+#define S5KKD1_REG_Y_ADDR_END		CCI_REG16(0x034a)
+#define S5KKD1_REG_X_OUTPUT_SIZE	CCI_REG16(0x034c)
+#define S5KKD1_REG_Y_OUTPUT_SIZE	CCI_REG16(0x034e)
+
+#define S5KKD1_REG_TEST_PATTERN		CCI_REG16(0x0600)
+
+#define to_s5kkd1(_sd)			container_of(_sd, struct s5kkd1, sd)
+
+static const s64 s5kkd1_link_freq_menu[] = {
+	S5KKD1_LINK_FREQ_906MHZ,
+};
+
+/* List of supported formats to cover horizontal and vertical flip controls */
+static const u32 s5kkd1_mbus_formats[] = {
+	MEDIA_BUS_FMT_SGRBG10_1X10,	MEDIA_BUS_FMT_SRGGB10_1X10,
+	MEDIA_BUS_FMT_SBGGR10_1X10,	MEDIA_BUS_FMT_SGBRG10_1X10,
+};
+
+struct s5kkd1_reg_list {
+	const struct cci_reg_sequence *regs;
+	unsigned int num_regs;
+};
+
+struct s5kkd1_mode {
+	u32 width;			/* Frame width in pixels */
+	u32 height;			/* Frame height in pixels */
+	u32 hts;			/* Horizontal timing size */
+	u32 vts;			/* Default vertical timing size */
+	u32 exposure;			/* Default exposure value */
+	u32 exposure_margin;		/* Exposure margin */
+	struct v4l2_rect crop;		/* Analogue crop in the pixel array */
+
+	const struct s5kkd1_reg_list reg_list;	/* Sensor register setting */
+};
+
+static const char * const s5kkd1_test_pattern_menu[] = {
+	"Disabled",
+	"Solid color",
+	"Color bars",
+	"Fade to grey color bars",
+	"PN9",
+};
+
+struct s5kkd1 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct clk *mclk;
+	struct gpio_desc *reset_gpio;
+	struct regulator *afvdd;	/* Autofocus actuator power */
+	struct regulator *vdda;		/* Analog power */
+	struct regulator *vddd;		/* Digital core power */
+	struct regulator *vddio;	/* Digital I/O power */
+
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *vflip;
+	struct v4l2_ctrl *hflip;
+
+	const struct s5kkd1_mode *mode;
+};
